# Local development values ONLY. Copy to .env (git-ignored). Never reuse these anywhere real.
POSTGRES_DB=gopulse
POSTGRES_USER=gopulse_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_PORT=5433
API_RO_PASSWORD=change-me-ro
API_RW_PASSWORD=change-me-rw

# Used by the publish job (owner) and the API (read-only / write-limited roles)
DATABASE_URL_OWNER=postgresql://gopulse_owner:change-me-owner@localhost:5433/gopulse
DATABASE_URL_RO=postgresql://gopulse_api_ro:change-me-ro@localhost:5433/gopulse
DATABASE_URL_RW=postgresql://gopulse_api_rw:change-me-rw@localhost:5433/gopulse

# API
CORS_ORIGINS=http://localhost:3000
DEMO_RUNS_PER_MINUTE=3
DEMO_RUNS_PER_HOUR=20
